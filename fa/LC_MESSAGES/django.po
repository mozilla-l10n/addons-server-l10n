#: src/olympia/constants/categories.py:65
msgid "Alerts & Updates"
msgstr "هشدارها و به‌روزرسانی‌ها"

#: src/olympia/constants/categories.py:67
msgid "Download Firefox extensions that help you stay up-to-date, track tasks, improve efficiency. Find extensions that reload tabs, manage productivity, and more."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که به شما در به‌روز ماندن، پیگیری کارها و بهبود بهره‌وری کمک می‌کنند. افزونه‌هایی برای بارگذاری مجدد زبانه‌ها، مدیریت بهره‌وری و موارد دیگر پیدا کنید."

#: src/olympia/constants/categories.py:75
msgid "Appearance"
msgstr "ظاهر برنامه"

#: src/olympia/constants/categories.py:77
msgid "Download extensions that modify the appearance of websites and the browser Firefox. This category includes extensions for dark themes, tab management, and more."
msgstr "افزونه‌هایی را دانلود کنید که ظاهر وب‌سایت‌ها و مرورگر فایرفاکس را تغییر می‌دهند. این دسته شامل افزونه‌هایی برای پوسته‌های تیره، مدیریت زبانه‌ها و موارد دیگر است."

#: src/olympia/constants/categories.py:85
msgid "Bookmarks"
msgstr "نشانک‌ها"

#: src/olympia/constants/categories.py:87
msgid "Download extensions that enhance bookmarks by password-protecting them, searching for duplicates, finding broken bookmarks, and more."
msgstr "افزونه‌هایی را دانلود کنید که با محافظت با رمز عبور، جستجوی نشانک‌های تکراری، یافتن نشانک‌های خراب و موارد دیگر، نشانک‌ها را ارتقا می‌دهند."

#: src/olympia/constants/categories.py:94
msgid "Download Management"
msgstr "مدیریت دانلود"

#: src/olympia/constants/categories.py:96
msgid "Download Firefox extensions that can help download web, music and video content. You can also find extensions to manage downloads, share files, and more."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که می‌توانند در دانلود محتوای وب، موسیقی و ویدیو کمک کنند. همچنین می‌توانید افزونه‌هایی برای مدیریت دانلودها، اشتراک‌گذاری فایل‌ها و موارد دیگر پیدا کنید."

#: src/olympia/constants/categories.py:103
msgid "Feeds, News & Blogging"
msgstr "فیدها، اخبار و وبلاگ‌نویسی"

#: src/olympia/constants/categories.py:105
msgid "Download Firefox extensions that remove clutter so you can stay up-to-date on social media, catch up on blogs, RSS feeds, reduce eye strain, and more."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که شلوغی‌های بصری را حذف می‌کنند تا بتوانید در شبکه‌های اجتماعی به‌روز بمانید، وبلاگ‌ها و فیدهای RSS را دنبال کنید، خستگی چشم را کاهش دهید و کارهای دیگر."

#: src/olympia/constants/categories.py:112
msgid "Games & Entertainment"
msgstr "بازی و سرگرمی"

#: src/olympia/constants/categories.py:114
msgid "Download Firefox extensions to boost your entertainment experience. This category includes extensions that can enhance gaming, control video playback, and more."
msgstr "افزونه‌های فایرفاکس را برای ارتقای تجربه سرگرمی خود دانلود کنید. این دسته شامل افزونه‌هایی است که بازی کردن را بهبود می‌بخشند، پخش ویدیو را کنترل می‌کنند و موارد دیگر."

#: src/olympia/constants/categories.py:121
msgid "Language Support"
msgstr "پشتیبانی زبان"

#: src/olympia/constants/categories.py:123
msgid "Download Firefox extensions that offer language support like grammar check, look-up words, translate text, provide text-to-speech, and more."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که پشتیبانی زبانی مانند بررسی دستور زبان، جستجوی کلمات، ترجمه متن، تبدیل متن به گفتار و موارد دیگر را ارائه می‌دهند."

#: src/olympia/constants/categories.py:130
msgid "Photos, Music & Videos"
msgstr "عکس، موسیقی و ویدیو"

#: src/olympia/constants/categories.py:132
msgid "Download Firefox extensions that enhance photo, music and video experiences. Extensions in this category modify audio and video, reverse image search, and more."
msgstr "افزونه‌های فایرفاکس را برای ارتقای تجربه عکس، موسیقی و ویدیو دانلود کنید. افزونه‌های این دسته می‌توانند صدا و تصویر را تغییر دهند، جستجوی معکوس تصویر انجام دهند و کارهای دیگر."

#. editorial content for the secondary hero shelves.
#: src/olympia/constants/categories.py:139 src/olympia/discovery/strings.jinja2:1138
msgid "Privacy & Security"
msgstr "حریم خصوصی و امنیت"

#: src/olympia/constants/categories.py:141
msgid "Download Firefox extensions to browse privately and securely. This category includes extensions to block annoying ads, prevent tracking, manage redirects, and more."
msgstr "افزونه‌های فایرفاکس را برای مرور خصوصی و ایمن دانلود کنید. این دسته شامل افزونه‌هایی برای مسدود کردن تبلیغات آزاردهنده، جلوگیری از ردیابی، مدیریت تغییر مسیرها و موارد دیگر است."

#: src/olympia/constants/categories.py:149
msgid "Search Tools"
msgstr "ابزارهای جستجو"

#: src/olympia/constants/categories.py:151
msgid "Download Firefox extensions for search and look-up. This category includes extensions that highlight and search text, lookup IP addresses/domains, and more."
msgstr "افزونه‌های فایرفاکس را برای جستجو و یافتن اطلاعات دانلود کنید. این دسته شامل افزونه‌هایی برای برجسته‌سازی و جستجوی متن، پیدا کردن نشانی‌های IP و دامنه‌ها و موارد دیگر است."

#: src/olympia/constants/categories.py:158
msgid "Shopping"
msgstr "خرید آنلاین"

#: src/olympia/constants/categories.py:160
msgid "Download Firefox extensions that can enhance your online shopping experience with coupon finders, deal finders, review analyzers, more."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که می‌توانند تجربه خرید آنلاین شما را با کدهای تخفیف‌یاب، پیشنهادات ویژه، تحلیل دیدگاه‌ها و موارد دیگر ارتقا دهند."

#: src/olympia/constants/categories.py:167
msgid "Social & Communication"
msgstr "شبکه‌های اجتماعی و ارتباطات"

#: src/olympia/constants/categories.py:169
msgid "Download Firefox extensions to enhance social media and instant messaging. This category includes improved tab notifications, video downloaders, and more."
msgstr "افزونه‌های فایرفاکس را برای ارتقای شبکه‌های اجتماعی و پیام‌رسانی فوری دانلود کنید. این دسته شامل بهبود اعلان‌های زبانه‌ها، دانلودکننده‌های ویدیو و موارد دیگر است."

#: src/olympia/constants/categories.py:176
msgid "Tabs"
msgstr "زبانه‌ها"

#: src/olympia/constants/categories.py:178
msgid "Download Firefox extension to customize tabs and the new tab page. Discover extensions that can control tabs, change the way you interact with them, and more."
msgstr "افزونه‌های فایرفاکس را برای شخصی‌سازی زبانه‌ها و صفحه برگه جدید دانلود کنید. افزونه‌هایی را کشف کنید که می‌توانند زبانه‌ها را کنترل کنند، نحوه تعامل شما با آن‌ها را تغییر دهند و موارد دیگر."

#: src/olympia/constants/categories.py:185
msgid "Web Development"
msgstr "توسعه وب"

#: src/olympia/constants/categories.py:187
msgid "Download Firefox extensions that feature web development tools. This category includes extensions for GitHub, user agent switching, cookie management, and more."
msgstr "افزونه‌های فایرفاکس دارای ابزارهای توسعه وب را دانلود کنید. این دسته شامل افزونه‌هایی برای گیت‌هاب، تغییر مشخصه کاربری (User Agent)، مدیریت کوکی‌ها و موارد دیگر است."

#: src/olympia/constants/categories.py:195 src/olympia/constants/categories.py:287 src/olympia/devhub/forms.py:640 src/olympia/devhub/serializers.py:9
msgid "Other"
msgstr "سایر"

#: src/olympia/constants/categories.py:198
msgid "Download Firefox extensions that can be unpredictable and creative, yet useful for those odd tasks."
msgstr "افزونه‌های فایرفاکس را دانلود کنید که می‌توانند غیرقابل پیش‌بینی و خلاقانه، و در عین حال برای کارهای خاص و متفاوت بسیار کاربردی باشند."

#: src/olympia/constants/categories.py:206
msgid "Abstract"
msgstr "انتزاعی"

#: src/olympia/constants/categories.py:208
msgid "Download Firefox artistic and conceptual themes. This category includes colorful palettes and shapes, fantasy landscapes, playful cats, psychedelic flowers."
msgstr "پوسته‌های هنری و مفهومی فایرفاکس را دانلود کنید. این دسته شامل پالت‌های رنگی و اشکال متنوع، مناظر فانتزی، گربه‌های بازیگوش و گل‌های چشم‌نواز است."

#: src/olympia/constants/categories.py:215
msgid "Causes"
msgstr "جنبش‌ها و آرمان‌ها"

#: src/olympia/constants/categories.py:217
msgid "Download Firefox themes for niche interests and topics. This category includes sports themes, holidays, philanthropic causes, nationalities, and much more."
msgstr "پوسته‌های فایرفاکس را برای علاقه‌مندی‌ها و موضوعات خاص دانلود کنید. این دسته شامل پوسته‌های ورزشی، تعطیلات، امور خیریه، ملیت‌ها و موارد دیگر است."

#: src/olympia/constants/categories.py:224
msgid "Fashion"
msgstr "مد و فشن"

#: src/olympia/constants/categories.py:226
msgid "Download Firefox themes that celebrate style of all forms—patterns, florals, textures, models, and more."
msgstr "پوسته‌های فایرفاکس را متناسب با انواع سبک‌ها و طرح‌ها—طرح‌های گرافیکی، گل‌دار، بافت‌ها، مدل‌ها و موارد دیگر دانلود کنید."

#: src/olympia/constants/categories.py:232
msgid "Film and TV"
msgstr "فیلم و تلویزیون"

#: src/olympia/constants/categories.py:234
msgid "Download Firefox themes with movies and television. This category includes anime like Uchiha Madara, movies like The Matrix, shows (Game of Thrones), and more."
msgstr "پوسته‌های فیلم و تلویزیون فایرفاکس را دانلود کنید. این دسته شامل انیمه‌هایی مانند مادارا اوچیها، فیلم‌هایی مانند ماتریکس، سریال‌ها (بازی تاج و تخت) و موارد دیگر است."

#: src/olympia/constants/categories.py:243
msgid "Download Firefox themes with the Firefox browser theme. This category includes colorful, diverse depictions of the Firefox logo, including more general fox themes."
msgstr "پوسته‌های فایرفاکس مرتبط با مرورگر فایرفاکس را دانلود کنید. این دسته شامل تصویرسازی‌های رنگارنگ و متنوع از نشان‌واره فایرفاکس، از جمله پوسته‌های روباه است."

#: src/olympia/constants/categories.py:250
msgid "Foxkeh"
msgstr "Foxkeh"

#: src/olympia/constants/categories.py:252
msgid "Download Firefox themes with the Japanese Firefox. This category includes themes that depict the cute Foxkeh mascot in various poses on diverse landscapes."
msgstr "پوسته‌های فایرفاکس مربوط به فایرفاکس ژاپنی را دانلود کنید. این دسته شامل پوسته‌هایی از نماد بامزه فاکس‌که (Foxkeh) در حالت‌ها و مناظر گوناگون است."

#: src/olympia/constants/categories.py:259
msgid "Holiday"
msgstr "تعطیلات"

#: src/olympia/constants/categories.py:261
msgid "Download Firefox themes with holidays. This category includes Christmas, Halloween, Thanksgiving, St. Patrick’s Day, Easter, Fourth of July, and more."
msgstr "پوسته‌های فایرفاکس متناسب با تعطیلات را دانلود کنید. این دسته شامل کریسمس، هالووین، روز شکرگزاری، روز سنت پاتریک، عید پاک، چهارم ژوئیه و موارد دیگر است."

#: src/olympia/constants/categories.py:268
msgid "Music"
msgstr "موسیقی"

#: src/olympia/constants/categories.py:270
msgid "Download Firefox themes for musical interests and artists. This category includes popular bands like Nirvana and BTS, instruments, music videos, and much more."
msgstr "پوسته‌های فایرفاکس متناسب با علایق موسیقی و هنرمندان را دانلود کنید. این دسته شامل گروه‌های محبوبی چون نیروانا و بی‌تی‌اس، سازها، موزیک‌ویدیوها و موارد دیگر است."

#: src/olympia/constants/categories.py:278
msgid "Nature"
msgstr "طبیعت"

#: src/olympia/constants/categories.py:280
msgid "Download Firefox themes with animals and natural landscapes. This category includes flowers, sunsets, foxes, seasons, planets, kittens, birds, and more."
msgstr "پوسته‌های فایرفاکس با تصاویر حیوانات و مناظر طبیعی را دانلود کنید. این دسته شامل گل‌ها، غروب خورشید، روباه‌ها، فصل‌ها، سیاره‌ها، بچه‌گربه‌ها، پرندگان و موارد دیگر است."

#: src/olympia/constants/categories.py:290
msgid "Download Firefox themes that are interesting, creative, and unique."
msgstr "پوسته‌های فایرفاکس جذاب، خلاقانه و منحصر‌به‌فرد را دانلود کنید."

#: src/olympia/constants/categories.py:295
msgid "Scenery"
msgstr "منظره"

#: src/olympia/constants/categories.py:297
msgid "Download Firefox themes that feature the environment and the natural world. This category includes sunsets, beaches, illustrations, city skylines, and more."
msgstr "پوسته‌های فایرفاکس با موضوع محیط زیست و طبیعت را دانلود کنید. این دسته شامل غروب آفتاب، سواحل، تصویرسازی‌ها، خط افق شهرها و موارد دیگر است."

#: src/olympia/constants/categories.py:304
msgid "Seasonal"
msgstr "فصلی"

#: src/olympia/constants/categories.py:306
msgid "Download Firefox themes for all four seasons—fall, winter, spring, and summer. Autumn leaves, snowy mountain peaks, sunny summer days, and spring flowers."
msgstr "پوسته‌های فایرفاکس مربوط به هر چهار فصل—پاییز، زمستان، بهار و تابستان را دانلود کنید. برگ‌های پاییزی، قله‌های برفی، روزهای آفتابی تابستان و شکوفه‌های بهاری."

#: src/olympia/constants/categories.py:313
msgid "Solid"
msgstr "تک‌رنگ"

#: src/olympia/constants/categories.py:315
msgid "Download Firefox themes with solid and gradient colors to personalize your browser. This category includes bold reds, pastels, soft greys, and much more."
msgstr "پوسته‌های فایرفاکس با رنگ‌های یکدست و گرادیان را برای شخصی‌سازی مرورگر خود دانلود کنید. این دسته شامل قرمز پررنگ، پاستلی، خاکستری ملایم و موارد بسیار دیگر است."

#: src/olympia/constants/categories.py:322
msgid "Sports"
msgstr "ورزش"

#: src/olympia/constants/categories.py:324
msgid "Download Firefox themes that feature a variety of sports. This category includes country flags, sports teams, soccer, hockey, and more."
msgstr "پوسته‌های فایرفاکس با موضوع انواع ورزش‌ها را دانلود کنید. این دسته شامل پرچم کشورها، تیم‌های ورزشی، فوتبال، هاکی و موارد دیگر است."

#: src/olympia/constants/categories.py:331
msgid "Websites"
msgstr "وب‌گاه‌ها"

